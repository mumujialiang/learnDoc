# ── 数据库 ────────────────────────────────────────────
# 默认：PostgreSQL（课程正文按它讲解）
DATABASE_URL=postgresql+asyncpg://mall:mall@127.0.0.1:5432/mall

# 切到 SQL Server 时注释掉上面一行，改用下面这行。
#
# 前置条件：
#   1. docker compose --profile mssql up -d
#   2. 装 ODBC Driver 18 for SQL Server
#   3. 建库：
#      docker exec mall-mssql /opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -P 'Mall@Passw0rd' -C -Q "if db_id('mall') is null create database mall;"
#   4. pip install -e ".[mssql]"
#
# 注意：密码里的 @ 必须写成 %40
# DATABASE_URL=mssql+aioodbc://sa:Mall%40Passw0rd@127.0.0.1:1433/mall?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# 如果本机只有 Windows 自带的老驱动（名字就叫 "SQL Server"），用这行：
# DATABASE_URL=mssql+aioodbc://sa:Mall%40Passw0rd@127.0.0.1:1433/mall?driver=SQL+Server&Encrypt=no

# ── 其他 ──────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0
DEBUG=true
